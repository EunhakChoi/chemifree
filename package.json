{
  "name": "chemifree",
  "version": "0.1.0",
  "private": true,
  "description": "An independently authored chemical drawing workspace for humans and agents. Scaffold stage.",
  "license": "MIT",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=11.13.0 <12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cargo run --locked --package chemifree-api",
    "dev:web": "npm run dev --workspace @chemifree/web",
    "build": "npm run build:web && cargo build --workspace --locked",
    "build:web": "npm run build --workspace @chemifree/web",
    "lint": "npm run lint --workspace @chemifree/web",
    "typecheck": "npm run typecheck --workspace @chemifree/web",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "test:client": "node scripts/web-client-check.mjs",
    "test:contracts": "node scripts/contract-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:routes": "node scripts/browser-route-race.mjs",
    "test:conformance": "cargo run --locked --quiet --package chemifree-conformance -- --out target/conformance/report.json conformance/suite.json",
    "conformance:record": "cargo run --locked --quiet --package chemifree-conformance -- --out docs/verification/conformance-report.json conformance/suite.json",
    "test:traceability": "node scripts/traceability-check.mjs",
    "test:checks": "node --test scripts/traceability-check.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:client && npm run build:web && npm run check:rust && npm run test:contracts && npm run test:conformance && npm run test:traceability && npm run test:checks"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-core": "1.56.1"
  }
}
