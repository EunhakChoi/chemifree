            "case:fields-persist-across-crash",
            "check:check:rust"
          ],
          "followups": []
        },
        {
          "id": "MODEL-02.2",
          "summary": "Hydrogen states are recorded and told apart as drawn: stated with a count of 0 to 16, unknown, or inferred (the default). An inferred state carries no count, since nothing computes one.",
          "status": "implemented",
          "implementation": [
            "crates/domain/src/states.rs",
            "crates/domain/src/document.rs",
            "crates/application/src/contract.rs",
