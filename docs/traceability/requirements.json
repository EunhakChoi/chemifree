    {
      "id": "OPS-02",
      "domain": "document",
      "summary": "Edits are atomic change sets with consistent references, undo/redo and revision checks.",
      "operations": [
        "document.transaction",
        "history.undo",
        "history.redo"
      ],
      "status": "partial",
      "parts": [
        {
          "id": "OPS-02.1",
          "summary": "A transaction applies all its commands or none; a refused transaction names the failing command index and leaves revision, content and history unchanged.",
          "status": "implemented",
          "implementation": [
            "crates/domain/src/document.rs",
            "crates/application/src/documents.rs"
          ],
          "evidence": [
            "case:transaction-all-or-nothing",
            "check:check:rust"
          ],
          "followups": []
        },
        {
          "id": "OPS-02.2",
          "summary": "Each changing transaction, undo and redo adds one revision; a transaction that changes nothing adds none; an edit after undo drops the redo branch without reusing atom ids.",
          "status": "implemented",
          "implementation": [
            "crates/domain/src/document.rs"
          ],
          "evidence": [
            "case:transaction-revision-and-no-op",
            "case:undo-redo-and-redo-branch",
            "check:check:rust"
          ],
          "followups": []
        },
        {
          "id": "OPS-02.3",
          "summary": "A write based on a stale revision is refused with the current revision and changes nothing.",
          "status": "implemented",
          "implementation": [
            "crates/application/src/documents.rs"
          ],
          "evidence": [
            "case:stale-revision-refused",
            "check:check:rust"
          ],
          "followups": []
        },
        {
          "id": "OPS-02.4",
          "summary": "Saved content and history survive a crash; edits neither saved nor drafted do not; an autosaved draft is recovered with its history; closing does not discard unsaved work without the confirmed revision.",
