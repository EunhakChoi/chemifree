    {
      "id": "MODEL-02",
      "domain": "chemical-graph",
      "summary": "Atoms carry element, isotope, charge, hydrogen, radical and query information, each compared atom by atom.",
      "operations": [
        "document.transaction",
        "chem.validate"
      ],
      "status": "partial",
      "parts": [
        {
          "id": "MODEL-02.1",
          "summary": "Atoms record an element symbol (1-118), a formal charge in -8..8 and an optional isotope mass number 1..999 as drawn; values outside these ranges are refused and change nothing.",
          "status": "implemented",
          "implementation": [
            "crates/domain/src/element.rs",
            "crates/domain/src/document.rs",
            "crates/application/src/contract.rs"
          ],
          "evidence": [
