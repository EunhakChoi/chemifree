{
  "id": "undo-redo-and-redo-branch",
  "title": "Undo and redo add revisions; a new edit after undo drops the redo branch without reusing ids",
  "requirements": [
    "OPS-02"
  ],
  "axis": "history",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        }
      ]
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "add_atom",
          "element": "N",
          "position": {
            "x": 30,
            "y": 0
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 2,
          "atoms": [
            {
              "id": "a1"
            },
            {
              "id": "a2"
            }
          ]
        }
      }
    },
    {
      "call": "undo",
      "document": "d",
      "expected_revision": 2,
      "expect": {
        "document": {
          "revision": 3,
          "atoms": [
            {
              "id": "a1"
            }
          ]
        },
        "session": {
          "undo_depth": 1,
          "redo_depth": 1
        }
      }
    },
    {
      "call": "redo",
      "document": "d",
      "expected_revision": 3,
      "expect": {
        "document": {
          "revision": 4,
          "atoms": [
            {
              "id": "a1"
            },
            {
              "id": "a2",
              "element": "N"
            }
          ]
        },
        "session": {
          "undo_depth": 2,
          "redo_depth": 0
        }
      }
    },
    {
      "call": "undo",
      "document": "d",
      "expected_revision": 4,
      "expect": {
        "document": {
          "revision": 5
        },
        "session": {
          "redo_depth": 1
        }
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 5,
      "commands": [
        {
          "op": "add_atom",
          "element": "O",
          "position": {
            "x": 0,
            "y": 30
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 6,
          "atoms": [
            {
              "id": "a1"
            },
            {
              "id": "a3",
              "element": "O"
            }
          ]
        },
        "session": {
          "undo_depth": 2,
          "redo_depth": 0
        }
      }
    },
    {
      "call": "redo",
      "document": "d",
      "expected_revision": 6,
      "expect_error": {
        "code": "nothing_to_redo"
      }
    }
  ]
}
