{
  "id": "aromaticity-adjacent-donors-refused-unchanged",
  "title": "A Kekule 1,2-dihydro-1,2-diazete has adjacent donor nitrogens, is unsupported, and its conversion to aromatic is refused and leaves the document unchanged",
  "requirements": ["MODEL-02", "CHEM-02"],
  "axis": "graph",
  "kind": "reject",
  "steps": [
    {"call":"create","bind":"d"},
    {"call":"transact","document":"d","expected_revision":0,"commands":[
      {"op":"add_atom","element":"N","position":{"x":0,"y":0}},
      {"op":"add_atom","element":"N","position":{"x":20,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":40,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":60,"y":0}},
      {"op":"add_bond","begin":"$0","end":"$1","order":"single"},
      {"op":"add_bond","begin":"$1","end":"$2","order":"single"},
      {"op":"add_bond","begin":"$2","end":"$3","order":"double"},
      {"op":"add_bond","begin":"$3","end":"$0","order":"single"}
    ],"expect":{"document":{"revision":1}}},
    {"call":"operation","document":"d","request":{"contract":1,"request_id":"diazete-inspect","profile":"preserve-semantics","operation":"chem.aromaticity","parameters":{}},
     "expect":{"outcome":"ok","document_revision":1,"model_id":"chemifree-aromaticity-2","result":{"systems":[{"classification":"unsupported","cycle_rank":1,"electrons":null,"reason":"adjacent_donors"}]}}},
    {"call":"operation","document":"d","request":{"contract":1,"request_id":"diazete-convert-refused","profile":"preserve-semantics","operation":"chem.aromaticity_convert","parameters":{"expected_revision":1,"to":"aromatic"}},
     "expect":{"outcome":"error","result":null,"model_id":"chemifree-aromaticity-2","diagnostics":[{"code":"invalid_command","details":{"reason":"adjacent_donors"}}]}},
    {"call":"get","document":"d",
     "expect":{"document":{"revision":1,"bonds":[{"order":"single"},{"order":"single"},{"order":"double"},{"order":"single"}]},"session":{"undo_depth":1,"redo_depth":0}}}
  ]
}
