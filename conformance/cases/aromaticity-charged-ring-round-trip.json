{
  "id": "aromaticity-charged-ring-round-trip",
  "title": "A Kekule pyridinium with a charged ring nitrogen is aromatic; both conversions keep the nitrogen charge and the Kekule pattern round-trips",
  "requirements": ["MODEL-02", "CHEM-02"],
  "axis": "graph",
  "kind": "accept",
  "steps": [
    {"call":"create","bind":"d"},
    {"call":"transact","document":"d","expected_revision":0,"commands":[
      {"op":"add_atom","element":"C","position":{"x":0,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":20,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":40,"y":0}},
      {"op":"add_atom","element":"N","position":{"x":60,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":80,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":100,"y":0}},
      {"op":"add_bond","begin":"$0","end":"$1","order":"double"},
      {"op":"add_bond","begin":"$1","end":"$2","order":"single"},
      {"op":"add_bond","begin":"$2","end":"$3","order":"double"},
      {"op":"add_bond","begin":"$3","end":"$4","order":"single"},
      {"op":"add_bond","begin":"$4","end":"$5","order":"double"},
      {"op":"add_bond","begin":"$5","end":"$0","order":"single"}
    ],"expect":{"document":{"revision":1}}},
    {"call":"transact","document":"d","expected_revision":1,"commands":[
      {"op":"update_atom","atom":"a4","charge":1}
    ],"expect":{"document":{"revision":2}}},
    {"call":"operation","document":"d","request":{"contract":1,"request_id":"pyridinium-inspect","profile":"preserve-semantics","operation":"chem.aromaticity","parameters":{}},
     "expect":{"outcome":"ok","document_revision":2,"model_id":"chemifree-aromaticity-2","result":{"snapshot":{"document":{"revision":2},"session":{"undo_depth":2}},"systems":[{"classification":"aromatic","cycle_rank":1,"electrons":6,"reason":null}]}}},
    {"call":"operation","document":"d","request":{"contract":1,"request_id":"pyridinium-to-aromatic","profile":"preserve-semantics","operation":"chem.aromaticity_convert","parameters":{"expected_revision":2,"to":"aromatic"}},
     "expect":{"outcome":"ok","document_revision":3,"model_id":"chemifree-aromaticity-2","result":{"document":{"bonds":[{"order":"aromatic"},{"order":"aromatic"},{"order":"aromatic"},{"order":"aromatic"},{"order":"aromatic"},{"order":"aromatic"}]},"session":{"undo_depth":3}}}},
    {"call":"operation","document":"d","request":{"contract":1,"request_id":"pyridinium-to-kekule","profile":"preserve-semantics","operation":"chem.aromaticity_convert","parameters":{"expected_revision":3,"to":"kekule"}},
     "expect":{"outcome":"ok","document_revision":4,"model_id":"chemifree-aromaticity-2","result":{"document":{"bonds":[{"order":"double"},{"order":"single"},{"order":"double"},{"order":"single"},{"order":"double"},{"order":"single"}]},"session":{"undo_depth":4}}}},
    {"call":"get","document":"d",
     "expect":{"document":{"revision":4,"atoms":{"$contains":[{"id":"a4","element":"N","charge":1}]},"bonds":[{"order":"double"},{"order":"single"},{"order":"double"},{"order":"single"},{"order":"double"},{"order":"single"}]},"session":{"undo_depth":4,"redo_depth":0}}}
  ]
}
