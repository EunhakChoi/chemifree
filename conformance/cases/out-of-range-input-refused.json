{
  "id": "out-of-range-input-refused",
  "title": "Out-of-range charge, isotope, coordinate, element and request_id are refused and change nothing",
  "requirements": [
    "MODEL-02",
    "API-01"
  ],
  "axis": "protocol",
  "kind": "reject",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "update_atom",
          "atom": "$0",
          "charge": 1
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "charge": 9
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "charge": -9
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "isotope": 1000
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "isotope": 0
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100001,
            "y": 0
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 0
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "Xx",
          "position": {
            "x": 0,
            "y": 0
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 0
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [],
      "expect_error": {
        "code": "invalid_command"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "request_id": "not valid!",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        }
      ],
      "expect_error": {
        "code": "invalid_request"
      }
    },
    {
      "call": "get",
      "document": "d",
      "expect": {
        "document": {
          "revision": 0,
          "atoms": []
        },
        "session": {
          "undo_depth": 0
        }
      }
    }
  ]
}
