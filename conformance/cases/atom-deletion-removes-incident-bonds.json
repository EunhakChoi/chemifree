{
  "id": "atom-deletion-removes-incident-bonds",
  "title": "Deleting an atom deletes exactly the bonds that touch it",
  "requirements": [
    "OPS-02",
    "OPS-01"
  ],
  "axis": "graph",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "add_atom",
          "element": "N",
          "position": {
            "x": 30,
            "y": 0
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "O",
          "position": {
            "x": 60,
            "y": 0
          },
          "bond_to": {
            "atom": "$1",
            "order": "double"
          }
        },
        {
          "op": "add_bond",
          "begin": "$0",
          "end": "$2",
          "order": "triple"
        }
      ],
      "expect": {
        "document": {
          "bonds": [
            {
              "id": "b1",
              "begin": "a1",
              "end": "a2",
              "order": "single"
            },
            {
              "id": "b2",
              "begin": "a2",
              "end": "a3",
              "order": "double"
            },
            {
              "id": "b3",
              "begin": "a1",
              "end": "a3",
              "order": "triple"
            }
          ]
        }
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "delete_atoms",
          "atoms": [
            "a2"
          ]
        }
      ],
      "expect": {
        "document": {
          "revision": 2,
          "atoms": [
            {
              "id": "a1"
            },
            {
              "id": "a3"
            }
          ],
          "bonds": [
            {
              "id": "b3",
              "begin": "a1",
              "end": "a3",
              "order": "triple"
            }
          ]
        }
      }
    },
    {
      "call": "undo",
      "document": "d",
      "expected_revision": 2,
      "expect": {
        "document": {
          "atoms": [
            {
              "id": "a1"
            },
            {
              "id": "a2"
            },
            {
              "id": "a3"
            }
          ],
          "bonds": [
            {
              "id": "b1"
            },
            {
              "id": "b2"
            },
            {
              "id": "b3"
            }
          ]
        }
      }
    }
  ]
}
