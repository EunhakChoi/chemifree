{
  "id": "atom-and-bond-states-refused",
  "title": "Atom and bond states that do not hold together are refused with the failing command's index and a stable reason, and change nothing",
  "requirements": [
    "MODEL-02",
    "API-01"
  ],
  "axis": "graph",
  "kind": "reject",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "add_atom",
          "element": "N",
          "position": {
            "x": 30,
            "y": 0
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        }
      ]
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "hydrogens": {
            "mode": "specified",
            "count": 17
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "hydrogen_count_out_of_range"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "hydrogens": {
            "mode": "specified"
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "hydrogen_count_missing"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "hydrogens": {
            "mode": "unknown",
            "count": 1
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "hydrogen_count_unexpected"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "query": {
            "kind": "any"
          },
          "charge": -1
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "query_atom_charge"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "query": {
            "kind": "halogen"
          },
          "isotope": 35
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "query_atom_isotope"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "query": {
            "kind": "list",
            "elements": []
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "query_list_empty"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "query": {
            "kind": "list",
            "elements": [
              "N",
              "O",
              "N"
            ]
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "query_list_repeated"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "query": {
            "kind": "list",
            "elements": [
              "H",
              "B",
              "C",
              "N",
              "O",
              "F",
              "P",
              "S",
              "Cl",
              "Br",
              "I"
            ]
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "query_list_too_long"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_bond",
          "bond": "b1",
          "order": "query",
          "query": {
            "kind": "any",
            "orders": [
              "single"
            ]
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "query_list_unexpected"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "element": "O",
          "query": {
            "kind": "any"
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "element_and_query"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "add_atom",
          "position": {
            "x": 60,
            "y": 0
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "atom_kind_missing"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_bond",
          "bond": "b1",
          "order": "query"
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "bond_query_missing"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_bond",
          "bond": "b1",
          "order": "aromatic",
          "query": {
            "kind": "any"
          }
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "bond_query_unexpected"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "attachment_points": [
            0
          ]
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "attachment_point_out_of_range"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "rename",
          "title": "Not applied"
        },
        {
          "op": "update_atom",
          "atom": "a1",
          "attachment_points": [
            3,
            3
          ]
        }
      ],
      "expect_error": {
        "code": "invalid_command",
        "command_index": 1,
        "reason": "attachment_point_repeated"
      }
    },
    {
      "call": "get",
      "document": "d",
      "expect": {
        "document": {
          "revision": 1,
          "title": "Untitled",
          "atoms": [
            {
              "id": "a1",
              "element": "C",
              "kind": "element",
              "charge": 0,
              "isotope": null,
              "hydrogens": {
                "mode": "inferred"
              },
              "radical": "none",
              "attachment_points": []
            },
            {
              "id": "a2",
              "element": "N"
            }
          ],
          "bonds": [
            {
              "id": "b1",
              "order": "single"
            }
          ]
        },
        "session": {
          "undo_depth": 1
        }
      }
    }
  ]
}
