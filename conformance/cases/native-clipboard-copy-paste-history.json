                  "isotope": 13
                },
                {
                  "id": "a3",
                  "element": "O",
                  "position": {
                    "x": 130,
                    "y": 230
                  }
                }
              ],
              "bonds": [
                {
                  "id": "b1",
                  "begin": "a2",
                  "end": "a3",
                  "order": "single",
                  "mark": {
                    "kind": "wedge",
                    "narrow": "begin"
