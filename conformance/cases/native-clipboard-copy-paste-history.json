              ],
              "selection": {
                "objects": [],
                "atoms": [
                  "a2",
                  "a3"
                ],
                "bonds": [
                  "b1"
                ]
              }
            },
            "session": {
              "undo_depth": 2,
              "redo_depth": 0
            }
          }
        }
      },
      "substitute": {
