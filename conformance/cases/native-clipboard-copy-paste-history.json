        }
      }
    },
    {
      "call": "operation",
      "document": "target",
      "request": {
        "contract": 1,
        "request_id": "paste-once",
        "profile": "preserve-semantics",
        "operation": "document.clipboard_paste",
        "parameters": {
          "expected_revision": 1,
          "payload": "",
          "offset": {
            "x": 20,
            "y": 30
          },
          "selection_before": {
            "objects": [],
            "atoms": [
              "a1"
            ],
            "bonds": []
          }
        }
      },
      "expect": {
