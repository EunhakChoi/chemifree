{
  "id": "smiles-malformed-and-unsupported-refused",
  "title": "Malformed, unsupported and unconsented SMILES changes nothing and names the position and the code",
  "requirements": [
    "CODEC-05",
    "CODEC-06"
  ],
  "axis": "encoding",
  "kind": "reject",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "dangling",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "C=(O)",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "dangling_bond",
            "details": {
              "class": "syntax",
              "offset": 1
            }
          }
        ]
      },
      "document": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "unclosed-ring",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "C2CC1CC",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "unclosed_ring",
            "details": {
              "class": "syntax",
              "offset": 1
            }
          }
        ]
      },
      "document": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "stereo",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "c1ccc/cc1",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "directional_bond_unsupported",
            "details": {
              "class": "unsupported",
              "offset": 5
            }
          }
        ]
      },
      "document": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "bridge",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "c1ccccc1:c1ccccc1",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "aromatic_bond_outside_ring",
            "details": {
              "class": "unsupported",
              "offset": 8
            }
          }
        ]
      },
      "document": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "system",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "c1ccccc1.c1cccc1",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "aromatic_system_unsupported",
            "details": {
              "class": "unsupported",
              "offset": 9
            }
          }
        ]
      },
      "document": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "ignored-preview",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "CCO ethanol",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "partial",
        "loss_report": {
          "$contains": [
            {
              "feature": "ignored_text"
            }
          ]
        }
      },
      "document": "d",
      "capture": {
        "digest": "/result/preview_digest"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "ignored-commit",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "CCO ethanol",
          "expected_revision": 0,
          "preview_digest": null
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "loss_consent_required"
          }
        ]
      },
      "document": "d",
      "substitute": {
        "/parameters/preview_digest": "digest"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "after",
        "profile": "preserve-semantics",
        "operation": "document.snapshot",
        "parameters": {}
      },
      "expect": {
        "outcome": "ok",
        "result": {
          "document": {
            "revision": 0,
            "atoms": []
          }
        }
      },
      "document": "d"
    }
  ]
}
