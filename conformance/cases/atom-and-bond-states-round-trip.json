{
  "id": "atom-and-bond-states-round-trip",
  "title": "Radicals, query atoms and bonds, aromatic, dative and unknown bonds, and attachment points are recorded as given (none turned into a neutral atom or single bond) and survive save, crash, reopen and undo",
  "requirements": [
    "MODEL-02"
  ],
  "axis": "graph",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          },
          "radical": "doublet",
          "attachment_points": [
            2,
            1
          ]
        },
        {
          "op": "add_atom",
          "query": {
            "kind": "list",
            "elements": [
              "N",
              "O"
            ],
            "negated": true
          },
          "position": {
            "x": 30,
            "y": 0
          },
          "bond_to": {
            "atom": "$0",
            "order": "aromatic"
          }
        },
        {
          "op": "add_atom",
          "query": {
            "kind": "any"
          },
          "position": {
            "x": 60,
            "y": 0
          },
          "radical": "unknown",
          "bond_to": {
            "atom": "$1",
            "order": "query",
            "query": {
              "kind": "any"
            }
          }
        },
        {
          "op": "add_atom",
          "element": "B",
          "position": {
            "x": 90,
            "y": 0
          }
        },
        {
          "op": "add_bond",
          "begin": "$1",
          "end": "$3",
          "order": "dative"
