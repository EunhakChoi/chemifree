      "expect": {
        "document": {
          "revision": 1,
          "atoms": [
            {
              "id": "a1",
              "element": "C",
              "kind": "element",
              "radical": "doublet",
              "attachment_points": [
                1,
                2
              ],
              "hydrogens": {
                "mode": "inferred"
              }
            },
            {
              "id": "a2",
              "element": "![N,O]",
              "kind": "query",
              "query": {
                "kind": "list",
                "elements": [
                  "N",
                  "O"
                ],
                "negated": true
              },
              "radical": "none",
              "attachment_points": []
