        {
          "op": "add_atom",
          "query": {
            "kind": "any_heavy"
          },
          "position": {
            "x": 120,
            "y": 0
          },
          "radical": "triplet",
          "bond_to": {
            "atom": "$3",
            "order": "unknown"
