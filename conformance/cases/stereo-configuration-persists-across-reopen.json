          "bond": "b4",
          "configuration": {
            "kind": "relative",
            "begin_neighbor": "a7",
            "end_neighbor": "a8",
            "relation": "opposite_sides"
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 4,
          "stereo": {
            "atoms": [
