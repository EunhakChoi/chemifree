          "revision": 1,
          "stereo": {
            "atoms": [],
            "bonds": []
          }
        }
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "set_atom_configuration",
          "atom": "a1",
          "configuration": {
            "kind": "tetrahedral",
            "neighbors": [
              "a3",
              "a2",
              "a4",
              "implicit_hydrogen"
            ],
            "turn": "clockwise"
          }
        },
        {
          "op": "set_bond_mark",
          "bond": "b2",
          "mark": {
            "kind": "wedge",
            "narrow": "begin"
          }
        },
        {
          "op": "set_bond_configuration",
          "bond": "b4",
          "configuration": {
            "kind": "relative",
            "begin_neighbor": "a7",
            "end_neighbor": "implicit_hydrogen",
            "relation": "same_side"
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 2,
          "stereo": {
            "atoms": [
              {
                "atom": "a1",
                "configuration": {
                  "kind": "tetrahedral",
                  "neighbors": [
                    "a2",
                    "a3",
                    "a4",
                    "implicit_hydrogen"
                  ],
                  "turn": "anticlockwise"
