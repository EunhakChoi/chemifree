              }
            ]
          },
          "bonds": [
            {
              "id": "b1",
              "mark": null
            },
            {
              "id": "b2",
              "mark": {
                "kind": "wedge",
                "narrow": "begin"
              }
            },
            {
              "id": "b3",
              "mark": null
            },
            {
              "id": "b4",
              "mark": null
            },
            {
              "id": "b5",
              "mark": null
            },
            {
              "id": "b6",
              "mark": null
            }
          ]
        },
        "notes": []
      }
