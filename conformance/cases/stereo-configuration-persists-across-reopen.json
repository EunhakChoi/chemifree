{
  "id": "stereo-configuration-persists-across-reopen",
  "title": "A stated configuration is stored in canonical form, saved, reopened, undone, redone, and a restatement changes nothing",
  "requirements": [
    "MODEL-03"
  ],
  "axis": "persistence",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "F",
          "position": {
            "x": 100,
            "y": 70
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Cl",
          "position": {
            "x": 126,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Br",
          "position": {
            "x": 74,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 200,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 230,
            "y": 100
          },
          "bond_to": {
            "atom": "$4",
            "order": "double"
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 180,
            "y": 120
          },
          "bond_to": {
            "atom": "$4",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 250,
            "y": 120
          },
          "bond_to": {
            "atom": "$5",
            "order": "single"
          }
        }
      ],
      "expect": {
