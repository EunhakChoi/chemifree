{
  "id": "smiles-import-export-roundtrip",
  "title": "A SMILES is previewed, imported, written recorded and canonical, and the canonical text is a fixpoint when imported again",
  "requirements": [
    "CODEC-05",
    "CODEC-06"
  ],
  "axis": "encoding",
  "kind": "accept",
  "steps": [
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "create-a",
        "profile": "preserve-semantics",
        "operation": "document.create",
        "parameters": {
          "title": "SMILES A"
        }
      },
      "expect": {
        "outcome": "ok",
        "document_revision": 0
      },
      "bind": "a"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "preview",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "expected_revision": 0,
          "source": "OC(C)=O.[Cl-]",
          "preview": true
        }
      },
      "expect": {
        "outcome": "partial",
        "document_revision": 0,
        "model_id": "chemifree-smiles-1",
        "result": {
          "atoms": 5,
          "bonds": 3,
          "parts": 2
        },
        "loss_report": {
          "$contains": [
            {
              "feature": "generated_layout"
            }
          ]
        }
      },
      "document": "a",
      "capture": {
        "digest": "/result/preview_digest"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "import",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "expected_revision": 0,
          "source": "OC(C)=O.[Cl-]",
          "preview_digest": null
        }
      },
      "expect": {
        "outcome": "partial",
        "document_revision": 1,
        "result": {
          "import_mapping": {
            "atoms": [
              "a1",
              "a2",
              "a3",
              "a4",
              "a5"
            ],
            "bonds": [
              "b1",
              "b2",
              "b3"
            ]
          }
        }
      },
      "document": "a",
      "substitute": {
        "/parameters/preview_digest": "digest"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "write-recorded",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "smiles",
          "style": "recorded"
        }
      },
      "expect": {
        "outcome": "partial",
        "document_revision": 1,
        "model_id": "chemifree-smiles-1",
        "result": {
          "content": "OC(C)=O.[Cl-]",
          "style": "recorded"
        },
        "loss_report": {
          "$contains": [
            {
              "feature": "coordinates"
            },
            {
              "feature": "native_ids"
            },
            {
              "feature": "drawing_settings"
            }
          ]
        }
      },
      "document": "a"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "write-canonical",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "smiles",
          "style": "canonical"
        }
      },
      "expect": {
        "outcome": "partial",
        "model_id": "chemifree-smiles-canonical-1",
        "result": {
          "content": "C(C)(=O)O.[Cl-]",
          "style": "canonical",
          "canonical": {
            "implementation": "chemifree-smiles-canonical-1",
            "graph_model": "chemifree-chemical-graph-2"
          }
        }
      },
      "document": "a",
      "capture": {
        "canonical": "/result/content"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "create-b",
        "profile": "preserve-semantics",
        "operation": "document.create",
        "parameters": {
          "title": "SMILES B"
        }
      },
      "expect": {
        "outcome": "ok",
        "document_revision": 0
      },
      "bind": "b"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "preview-b",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "expected_revision": 0,
          "source": null,
          "preview": true
        }
      },
      "expect": {
        "outcome": "partial"
      },
      "document": "b",
      "substitute": {
        "/parameters/source": "canonical"
      },
      "capture": {
        "digest_b": "/result/preview_digest"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "import-b",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "expected_revision": 0,
          "source": null,
          "preview_digest": null
        }
      },
      "expect": {
        "outcome": "partial",
        "document_revision": 1
      },
      "document": "b",
      "substitute": {
        "/parameters/source": "canonical",
        "/parameters/preview_digest": "digest_b"
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "write-canonical-b",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "smiles",
          "style": "canonical"
        }
      },
      "expect": {
        "outcome": "partial",
        "result": {
          "content": "C(C)(=O)O.[Cl-]"
        }
      },
      "document": "b"
    }
  ]
}
