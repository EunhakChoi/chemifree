{
  "id": "svg-export-needs-consent",
  "title": "SVG export refuses an undrawn stated configuration until its loss digest is repeated, and an edit to the drawing makes that digest stale",
  "requirements": [
    "RENDER-01"
  ],
  "axis": "scene",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "F",
          "position": {
            "x": 100,
            "y": 70
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Cl",
          "position": {
            "x": 126,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Br",
          "position": {
            "x": 74,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "set_bond_mark",
          "bond": "$2",
          "mark": {
            "kind": "wedge",
            "narrow": "begin"
          }
        },
        {
          "op": "set_atom_configuration",
          "atom": "a1",
          "configuration": {
            "kind": "tetrahedral",
            "neighbors": [
              "a2",
              "a3",
              "a4",
              "implicit_hydrogen"
            ],
            "turn": "clockwise"
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 1
        }
      }
    },
    {
      "call": "operation",
      "document": "d",
      "request": {
        "contract": 1,
        "request_id": "refused",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "svg"
        }
      },
      "capture": {
        "digest": "/diagnostics/0/details/loss_digest"
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "loss_consent_required",
            "details": {
              "features": [
                "stereo_configuration"
              ]
            }
          }
        ]
      }
    },
    {
      "call": "operation",
      "document": "d",
      "request": {
        "contract": 1,
        "request_id": "accepted",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "svg",
          "accepted_losses": null
        }
      },
      "substitute": {
        "/parameters/accepted_losses": "digest"
      },
      "expect": {
        "outcome": "partial",
        "result": {
          "media_type": "image/svg+xml"
        },
        "loss_report": {
          "$contains": [
            {
              "feature": "stereo_configuration",
              "source_path": "document.stereo",
              "disposition": "dropped",
              "semantic_impact": "stereo"
            }
          ]
        }
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "update_settings",
          "line_width_pt": 2.4
        }
      ],
      "expect": {
        "document": {
          "revision": 2
        }
      }
    },
    {
      "call": "operation",
      "document": "d",
      "request": {
        "contract": 1,
        "request_id": "stale",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "svg",
          "accepted_losses": null
        }
      },
      "substitute": {
        "/parameters/accepted_losses": "digest"
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "loss_consent_changed"
          }
        ]
      }
    }
  ]
}
