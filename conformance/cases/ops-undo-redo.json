{
  "id": "ops-undo-redo",
  "title": "Undo and redo restore exact states as new revisions; a new edit drops the redo branch",
  "requirements": ["OPS-02"],
  "axis": "history",
  "kind": "accept",
  "steps": [
    { "call": "create", "doc": "d", "title": "History" },
    {
      "call": "transact", "doc": "d", "expected_revision": 0,
      "commands": [{ "op": "add_atom", "element": "C", "position": { "x": 0, "y": 0 } }],
      "expect": { "document": { "revision": 1 } }
    },
    {
      "call": "transact", "doc": "d", "expected_revision": 1,
      "commands": [{ "op": "add_atom", "element": "O", "position": { "x": 20, "y": 0 }, "bond_to": { "atom": "a1", "order": "double" } }],
      "expect": { "document": { "revision": 2, "bonds": [{ "id": "b1", "order": "double" }] } }
    },
    {
      "call": "undo", "doc": "d", "expected_revision": 2,
      "expect": {
        "document": { "revision": 3, "atoms": [{ "id": "a1" }], "bonds": [] },
        "session": { "undo_depth": 1, "redo_depth": 1 }
      }
    },
    {
      "call": "redo", "doc": "d", "expected_revision": 3,
      "expect": {
        "document": { "revision": 4, "atoms": [{ "id": "a1" }, { "id": "a2", "element": "O" }], "bonds": [{ "id": "b1", "begin": "a1", "end": "a2", "order": "double" }] },
        "session": { "undo_depth": 2, "redo_depth": 0 }
      }
    },
    { "call": "undo", "doc": "d", "expected_revision": 4, "expect": { "document": { "revision": 5 }, "session": { "redo_depth": 1 } } },
    {
      "call": "transact", "doc": "d", "expected_revision": 5,
      "note": "the undone atom's identifier a2 is not reused",
      "commands": [{ "op": "add_atom", "element": "N", "position": { "x": 0, "y": 20 } }],
      "expect": {
        "document": { "revision": 6, "atoms": [{ "id": "a1" }, { "id": "a3", "element": "N" }] },
        "session": { "undo_depth": 2, "redo_depth": 0 }
      }
    },
    { "call": "redo", "doc": "d", "expected_revision": 6, "expect_error": { "code": "nothing_to_redo" } }
  ]
}
