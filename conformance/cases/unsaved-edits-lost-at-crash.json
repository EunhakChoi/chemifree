{
  "id": "unsaved-edits-lost-at-crash",
  "title": "Edits that were neither saved nor drafted are gone after a crash; the last save remains",
  "requirements": [
    "OPS-02"
  ],
  "axis": "persistence",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        }
      ]
    },
    {
      "call": "save",
      "document": "d",
      "expected_revision": 1
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "add_atom",
          "element": "N",
          "position": {
            "x": 30,
            "y": 0
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 2
        },
        "session": {
          "unsaved_changes": true,
          "draft_revision": null
        }
      }
    },
    {
      "call": "restart"
    },
    {
      "call": "get",
      "document": "d",
      "expect": {
        "document": {
          "revision": 1,
          "atoms": [
            {
              "id": "a1",
              "element": "C"
            }
          ]
        },
        "session": {
          "unsaved_changes": false
        },
        "recovery": null
      }
    }
  ]
}
