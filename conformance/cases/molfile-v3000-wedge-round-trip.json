{
  "id": "molfile-v3000-wedge-round-trip",
  "title": "A wedge drawing with an absolute group is written as V3000 with CFG=1, a STEABS collection and the chiral flag, imported into another document with its mark, configuration and group, and survives reopening",
  "requirements": [
    "CODEC-03"
  ],
  "axis": "encoding",
  "kind": "accept",
  "steps": [
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "create-source",
        "profile": "preserve-semantics",
        "operation": "document.create",
        "parameters": {
          "title": "Stereo"
        }
      },
      "capture": {
        "id": "/result/document/id"
      },
      "bind": "source",
      "expect": {
        "outcome": "ok",
        "document_revision": 0
      }
    },
    {
      "call": "transact",
      "document": "source",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "F",
          "position": {
            "x": 100,
            "y": 70
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Cl",
          "position": {
            "x": 126,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Br",
          "position": {
            "x": 74,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "set_bond_mark",
          "bond": "$2",
          "mark": {
            "kind": "wedge",
            "narrow": "begin"
          }
        },
        {
          "op": "set_atom_configuration",
          "atom": "a1",
          "configuration": {
            "kind": "tetrahedral",
            "neighbors": [
              "a2",
              "a3",
              "a4",
              "implicit_hydrogen"
            ],
            "turn": "clockwise"
          }
        },
        {
          "op": "create_stereo_group",
          "kind": "absolute",
          "atoms": [
            "a1"
          ],
          "number": null
        }
      ],
      "expect": {
        "document": {
          "revision": 1
        }
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "export",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "mol",
          "ctab": "v3000",
          "records": [
            {
              "document_id": null
            }
          ]
        }
      },
      "substitute": {
        "/parameters/records/0/document_id": "id"
      },
      "capture": {
        "mol": "/result/content"
      },
      "expect": {
        "outcome": "partial",
        "result": {
          "ctab": "v3000",
          "content": "Stereo\n\n\n  0  0  0     0  0            999 V3000\nM  V30 BEGIN CTAB\nM  V30 COUNTS 4 3 0 0 1\nM  V30 BEGIN ATOM\nM  V30 1 C 5.0000 -5.0000 0.0000 0\nM  V30 2 F 5.0000 -3.5000 0.0000 0\nM  V30 3 Cl 6.3000 -5.7500 0.0000 0\nM  V30 4 Br 3.7000 -5.7500 0.0000 0\nM  V30 END ATOM\nM  V30 BEGIN BOND\nM  V30 1 1 1 2\nM  V30 2 1 1 3 CFG=1\nM  V30 3 1 1 4\nM  V30 END BOND\nM  V30 BEGIN COLLECTION\nM  V30 MDLV30/STEABS ATOMS=(1 1)\nM  V30 END COLLECTION\nM  V30 END CTAB\nM  END\n"
        },
        "loss_report": {
          "$contains": [
            {
              "feature": "native_ids"
            },
            {
              "feature": "stereo_group_identity"
            }
          ]
        }
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "create-target",
        "profile": "preserve-semantics",
        "operation": "document.create",
        "parameters": {
          "title": "Target"
        }
      },
      "bind": "target",
      "expect": {
        "outcome": "ok",
        "document_revision": 0
      }
    },
    {
      "call": "operation",
      "document": "target",
      "request": {
        "contract": 1,
        "request_id": "preview",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "mol",
          "source": null,
          "record": 1,
          "expected_revision": 0,
          "preview": true
        }
      },
      "substitute": {
        "/parameters/source": "mol"
      },
      "capture": {
        "digest": "/result/preview_digest"
      },
      "expect": {
        "outcome": "partial",
        "document_revision": 0,
        "result": {
          "document": {
            "revision": 1,
            "bonds": [
              {
                "begin": "a1",
                "end": "a2",
                "mark": null
              },
              {
                "begin": "a1",
                "end": "a3",
                "mark": {
                  "kind": "wedge",
                  "narrow": "begin"
                }
              },
              {
                "begin": "a1",
                "end": "a4",
                "mark": null
              }
            ],
            "stereo": {
              "atoms": [
                {
                  "atom": "a1",
                  "configuration": {
                    "kind": "tetrahedral",
                    "neighbors": [
                      "a2",
                      "a3",
                      "a4",
                      "implicit_hydrogen"
                    ],
                    "turn": "clockwise"
                  }
                }
              ],
              "groups": [
                {
                  "id": "e1",
                  "kind": "absolute",
                  "stored_number": null,
                  "members": [
                    "a1"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "call": "operation",
      "document": "target",
      "request": {
        "contract": 1,
        "request_id": "import",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "mol",
          "source": null,
          "record": 1,
          "expected_revision": 0,
          "preview_digest": null,
          "accept_loss": true
        }
      },
      "substitute": {
        "/parameters/source": "mol",
        "/parameters/preview_digest": "digest"
      },
      "expect": {
        "outcome": "partial",
        "document_revision": 1,
        "result": {
          "document": {
            "bonds": [
              {
                "begin": "a1",
                "end": "a2",
                "mark": null
              },
              {
                "begin": "a1",
                "end": "a3",
                "mark": {
                  "kind": "wedge",
                  "narrow": "begin"
                }
              },
              {
                "begin": "a1",
                "end": "a4",
                "mark": null
              }
            ],
            "stereo": {
              "atoms": [
                {
                  "atom": "a1",
                  "configuration": {
                    "kind": "tetrahedral",
                    "neighbors": [
                      "a2",
                      "a3",
                      "a4",
                      "implicit_hydrogen"
                    ],
                    "turn": "clockwise"
                  }
                }
              ],
              "groups": [
                {
                  "id": "e1",
                  "kind": "absolute",
                  "stored_number": null,
                  "members": [
                    "a1"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "call": "save",
      "document": "target",
      "expected_revision": 1,
      "expect": {
        "session": {
          "saved_revision": 1
        }
      }
    },
    {
      "call": "restart"
    },
    {
      "call": "get",
      "document": "target",
      "expect": {
        "document": {
          "revision": 1,
          "bonds": [
            {
              "begin": "a1",
              "end": "a2",
              "mark": null
            },
            {
              "begin": "a1",
              "end": "a3",
              "mark": {
                "kind": "wedge",
                "narrow": "begin"
              }
            },
            {
              "begin": "a1",
              "end": "a4",
              "mark": null
            }
          ],
          "stereo": {
            "atoms": [
              {
                "atom": "a1",
                "configuration": {
                  "kind": "tetrahedral",
                  "neighbors": [
                    "a2",
                    "a3",
                    "a4",
                    "implicit_hydrogen"
                  ],
                  "turn": "clockwise"
                }
              }
            ],
            "groups": [
              {
                "id": "e1",
                "kind": "absolute",
                "stored_number": null,
                "members": [
                  "a1"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
