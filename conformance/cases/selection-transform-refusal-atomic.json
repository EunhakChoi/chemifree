{
  "id": "selection-transform-refusal-atomic",
  "title": "Unsupported rectangle rotations, identity target errors, coordinate overflow and malformed reflection requests are atomic refusals",
  "requirements": [
    "OPS-01",
    "OPS-02",
    "API-01"
  ],
  "axis": "scene",
  "kind": "reject",
  "steps": [
    {
      "call": "create",
      "bind": "d",
      "title": "Transform rollback"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "add_graphic",
          "shape": "rectangle",
          "points": [
            {
              "x": 1,
              "y": 1
            },
            {
              "x": 3,
              "y": 2
            }
          ]
        },
        {
          "op": "add_graphic",
          "shape": "line",
          "points": [
            {
              "x": -100000,
              "y": 0
            },
            {
              "x": 0,
              "y": 0
            }
          ]
        },
        {
          "op": "group",
          "objects": [
            "s1",
            "s2"
          ]
        }
      ],
      "expect": {
        "document": {
          "revision": 1,
          "title": "Transform rollback",
          "atoms": [
            {
              "id": "a1",
              "position": {
                "x": 0,
                "y": 0
              }
            }
          ],
          "scene": {
            "objects": {
              "$contains": [
                {
                  "id": "s4",
                  "kind": "group",
                  "children": [
                    "s1",
                    "s2"
                  ]
                },
                {
                  "id": "s2",
                  "shape": "rectangle",
                  "points": [
                    {
                      "x": 1,
                      "y": 1
                    },
                    {
                      "x": 3,
                      "y": 2
                    }
                  ]
                },
                {
                  "id": "s3",
                  "shape": "line",
                  "points": [
                    {
                      "x": -100000,
                      "y": 0
                    },
                    {
                      "x": 0,
                      "y": 0
                    }
                  ]
                }
              ]
            }
          },
          "selection": {
            "objects": [],
            "atoms": [],
            "bonds": []
          }
        },
        "session": {
          "undo_depth": 1,
          "redo_depth": 0
        }
      }
    },
    {
      "call": "operation",
      "document": "d",
      "request": {
        "contract": 1,
        "request_id": "transform-refusal-0",
        "profile": "preserve-semantics",
        "operation": "document.transform_plan",
        "parameters": {
          "selection": {
            "objects": [
              "s4"
            ]
          },
          "instance": "s1",
          "pivot": {
            "x": 0,
            "y": 0
          },
          "transform": {
            "type": "rotate",
            "degrees": 45
          }
        }
      },
      "expect": {
        "outcome": "error",
        "document_revision": 1,
        "result": null,
        "diagnostics": [
          {
            "code": "invalid_command",
            "details": {
              "reason": "transform_rectangle_unsupported"
