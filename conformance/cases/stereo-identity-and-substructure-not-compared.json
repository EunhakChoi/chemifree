            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "set_atom_configuration",
          "atom": "a1",
          "configuration": {
            "kind": "tetrahedral",
            "neighbors": [
              "a2",
              "a3",
              "a4",
              "implicit_hydrogen"
