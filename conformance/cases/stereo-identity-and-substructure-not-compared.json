{
  "id": "stereo-identity-and-substructure-not-compared",
  "title": "Identity and substructure search never read stereo: two drawings with opposite stated turns match, and the reply says stereo was not compared and was present",
  "requirements": [
    "MODEL-03"
  ],
  "axis": "graph",
  "kind": "accept",
  "steps": [
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "create-left",
        "profile": "preserve-semantics",
        "operation": "document.create",
        "parameters": {
          "title": "left"
        }
      },
      "bind": "left",
      "capture": {
        "left_id": "/result/document/id"
      },
      "expect": {
        "outcome": "ok",
        "document_revision": 0
      }
    },
    {
      "call": "transact",
      "document": "left",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "F",
          "position": {
            "x": 100,
            "y": 70
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
