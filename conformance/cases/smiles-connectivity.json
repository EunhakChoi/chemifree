{
  "id": "smiles-connectivity",
  "title": "SMILES is imported only after loss consent, refused with a position when invalid, and written in recorded and canonical order without editing the drawing",
  "requirements": ["CODEC-05", "CODEC-06"],
  "axis": "encoding",
  "kind": "accept",
  "steps": [
    {
      "call": "operation",
      "request": {"contract": 1, "request_id": "create-target", "profile": "preserve-semantics", "operation": "document.create", "parameters": {"title": "SMILES target"}},
      "bind": "target",
      "expect": {"outcome": "ok", "document_revision": 0}
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "bad-syntax", "profile": "preserve-semantics", "operation": "document.import",
        "parameters": {"format": "smiles", "source": "CC(C", "expected_revision": 0, "preview": true}},
      "expect": {"outcome": "error", "diagnostics": [{"code": "invalid_smiles", "details": {"reason": "unclosed_branch", "start": 1, "end": 2}}]}
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "stereo", "profile": "preserve-semantics", "operation": "document.import",
        "parameters": {"format": "smiles", "source": "F/C=C/F", "expected_revision": 0, "preview": true}},
      "expect": {"outcome": "unsupported", "diagnostics": [{"code": "smiles_unsupported", "details": {"reason": "stereo_unsupported", "start": 1, "end": 2}}]}
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "preview", "profile": "preserve-semantics", "operation": "document.import",
        "parameters": {"format": "smiles", "source": "OC(=O)C  acetic acid", "expected_revision": 0, "preview": true}},
      "capture": {"digest": "/result/preview_digest"},
      "expect": {
        "outcome": "partial", "document_revision": 0, "model_id": "chemifree-smiles-1",
        "result": {"atoms": 4, "bonds": 3, "implementation": "chemifree-smiles", "version": "1"},
        "loss_report": {"$contains": [{"feature": "ignored_text", "source_path": "source[9..20]"}, {"feature": "generated_coordinates"}]}
      }
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "refused-without-consent", "profile": "preserve-semantics", "operation": "document.import",
        "parameters": {"format": "smiles", "source": "OC(=O)C  acetic acid", "expected_revision": 0, "preview_digest": null}},
      "substitute": {"/parameters/preview_digest": "digest"},
      "expect": {"outcome": "error", "diagnostics": [{"code": "loss_consent_required"}]}
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "import", "profile": "preserve-semantics", "operation": "document.import",
        "parameters": {"format": "smiles", "source": "OC(=O)C  acetic acid", "expected_revision": 0, "preview_digest": null, "accept_loss": true}},
      "substitute": {"/parameters/preview_digest": "digest"},
      "expect": {
        "outcome": "partial", "document_revision": 1,
        "result": {"import_mapping": {"atoms": ["a1", "a2", "a3", "a4"], "bonds": ["b1", "b2", "b3"]},
          "document": {"atoms": [{"element": "O"}, {"element": "C"}, {"element": "O"}, {"element": "C"}]}}
      }
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "write-recorded", "profile": "preserve-semantics", "operation": "document.export",
        "parameters": {"format": "smiles", "mode": "recorded"}},
      "expect": {"outcome": "ok", "document_revision": 1, "model_id": "chemifree-smiles-1",
        "result": {"smiles": "OC(=O)C", "atoms": ["a1", "a2", "a3", "a4"], "snapshot": {"document": {"revision": 1}}}}
    },
    {
      "call": "operation",
      "document": "target",
      "request": {"contract": 1, "request_id": "write-canonical", "profile": "preserve-semantics", "operation": "document.export",
        "parameters": {"format": "smiles", "mode": "canonical"}},
      "expect": {"outcome": "ok", "document_revision": 1, "model_id": "chemifree-smiles-canonical-1",
        "result": {"smiles": "C(C)(=O)O", "implementation": "chemifree-smiles-canonical", "version": "1",
          "models": {"identity": "chemifree-chemical-graph-1"}}}
    },
    {
      "call": "get",
      "document": "target",
      "expect": {"document": {"revision": 1}, "session": {"undo_depth": 1, "redo_depth": 0}}
    }
  ]
}
