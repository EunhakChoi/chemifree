{
  "id": "svg-export-drawing",
  "title": "A carbon chain ending in an oxygen exports its recorded SVG drawing and reports the chemical graph as not drawn",
  "requirements": [
    "RENDER-01"
  ],
  "axis": "scene",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 26,
            "y": -15
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "O",
          "position": {
            "x": 52,
            "y": 0
          },
          "bond_to": {
            "atom": "$1",
            "order": "single"
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 1
        }
      }
    },
    {
      "call": "operation",
      "document": "d",
      "request": {
        "contract": 1,
        "request_id": "svg-drawing",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "svg"
        }
      },
      "expect": {
        "outcome": "partial",
        "result": {
          "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" width=\"66.28pt\" height=\"32.4pt\" viewBox=\"-4 -19 66.28 32.4\">\n<g>\n<g fill=\"none\" stroke=\"#000000\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n<line x1=\"0\" y1=\"0\" x2=\"26\" y2=\"-15\"/>\n<line x1=\"26\" y1=\"-15\" x2=\"43.72\" y2=\"-4.78\"/>\n</g>\n<g fill=\"#000000\" font-family=\"sans-serif\">\n<text x=\"52\" y=\"0\" text-anchor=\"middle\" dominant-baseline=\"central\" xml:space=\"preserve\"><tspan font-size=\"12\" font-weight=\"500\">O</tspan></text>\n</g>\n</g>\n</svg>\n",
          "media_type": "image/svg+xml"
        },
        "loss_report": {
          "$contains": [
            {
              "feature": "chemical_graph",
              "source_path": "document",
              "disposition": "dropped",
              "semantic_impact": "chemistry"
            }
          ]
        }
      }
    }
  ]
}
