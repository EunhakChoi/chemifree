{
  "id": "query-matching",
  "title": "A bounded ring query reports source-to-target mappings and incomplete searches",
  "requirements": ["MODEL-02", "CHEM-02"],
  "axis": "graph",
  "kind": "accept",
  "steps": [
    {"call":"create","bind":"q"},
    {"call":"operation","bind":"t","request":{"contract":1,"request_id":"target","profile":"preserve-semantics","operation":"document.create","parameters":{"title":"Triangle"}},"capture":{"target_id":"/result/document/id"},"expect":{"outcome":"ok"}},
    {"call":"transact","document":"q","expected_revision":0,"commands":[
      {"op":"add_atom","element":"C","position":{"x":0,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":20,"y":0},"bond_to":{"atom":"$0","order":"single"}}
    ],"expect":{"document":{"revision":1}}},
    {"call":"transact","document":"t","expected_revision":0,"commands":[
      {"op":"add_atom","element":"C","position":{"x":0,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":20,"y":0}},
      {"op":"add_atom","element":"C","position":{"x":10,"y":20}},
      {"op":"add_bond","begin":"$0","end":"$1","order":"single"},
      {"op":"add_bond","begin":"$1","end":"$2","order":"single"},
      {"op":"add_bond","begin":"$2","end":"$0","order":"single"}
    ],"expect":{"document":{"revision":1}}},
    {"call":"operation","document":"q","request":{"contract":1,"request_id":"bounded","profile":"preserve-semantics","operation":"chem.query_match","parameters":{"target_document_id":null,"mode":"recorded","predicates":[{"atom":"a1","ring":true,"min_neighbors":2,"max_neighbors":2}],"max_matches":1}},
     "substitute":{"/parameters/target_document_id":"target_id"},
     "expect":{"outcome":"partial","model_id":"chemifree-query-recorded-1","result":{"complete":false,"limit":"mappings","mappings":[[{"query_atom":"a1","target_atom":"a1"},{"query_atom":"a2","target_atom":"a2"}]],"query_snapshot":{"document":{"revision":1}},"target_snapshot":{"document":{"revision":1}}},"loss_report":{"$contains":[{"feature":"additional_mappings","disposition":"unknown"}]}}},
    {"call":"get","document":"q","expect":{"document":{"revision":1},"session":{"undo_depth":1}}},
    {"call":"get","document":"t","expect":{"document":{"revision":1},"session":{"undo_depth":1}}}
  ]
}
