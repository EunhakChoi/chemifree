{
  "id": "smiles-stereo-read-refusals-change-nothing",
  "title": "A SMILES stereo mark or CXSMILES block the drawing cannot hold is refused with its code, family and position, and the document stays empty",
  "requirements": [
    "CODEC-05",
    "CODEC-06",
    "STEREO-01"
  ],
  "axis": "encoding",
  "kind": "reject",
  "steps": [
    {
      "call": "create",
      "bind": "d"
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "r0",
        "profile": "preserve-semantics",
        "operation": "document.import",
        "parameters": {
          "format": "smiles",
          "source": "F[C@TH1H](Cl)Br",
          "expected_revision": 0,
          "preview": true
        }
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "stereo_class_unsupported",
            "details": {
              "class": "unsupported",
              "family": "unsupported_feature",
              "offset": 3
            }
          }
        ]
      },
      "document": "d"
    },
    {
      "call": "operation",
