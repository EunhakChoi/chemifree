{
  "id": "stereo-set-from-drawing-parity-pair",
  "title": "The same four neighbors [F, Cl, Br, implicit hydrogen] drawn with Cl and Br exchanged give the two parities, derived from the picture and not stated",
  "requirements": [
    "MODEL-03"
  ],
  "axis": "stereo",
  "kind": "accept",
  "steps": [
    {
      "call": "create",
      "bind": "p"
    },
    {
      "call": "transact",
      "document": "p",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "F",
          "position": {
            "x": 100,
            "y": 70
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Cl",
          "position": {
            "x": 126,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Br",
          "position": {
            "x": 74,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "set_bond_mark",
          "bond": "$2",
          "mark": {
            "kind": "wedge",
            "narrow": "begin"
          }
        },
        {
          "op": "set_configuration_from_drawing",
          "atoms": [
            "$0"
          ]
        }
      ],
      "expect": {
        "document": {
          "revision": 1,
          "stereo": {
            "atoms": [
              {
                "atom": "a1",
                "configuration": {
                  "kind": "tetrahedral",
                  "neighbors": [
                    "a2",
                    "a3",
                    "a4",
                    "implicit_hydrogen"
                  ],
                  "turn": "clockwise"
                }
              }
            ],
            "bonds": []
          }
        }
      }
    },
    {
      "call": "create",
