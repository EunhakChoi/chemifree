          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 130,
            "y": 100
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 130
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 70,
            "y": 100
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "set_bond_mark",
