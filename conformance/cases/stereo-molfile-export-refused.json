{
  "id": "stereo-molfile-export-refused",
  "title": "A V2000 molfile cannot carry the stereo of a drawing yet, so the export is refused and names the record; without stereo it writes",
  "requirements": [
    "MODEL-03",
    "CODEC-03"
  ],
  "axis": "encoding",
  "kind": "reject",
  "steps": [
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "create",
        "profile": "preserve-semantics",
        "operation": "document.create",
        "parameters": {
          "title": "Stereo"
        }
      },
      "expect": {
        "outcome": "ok",
        "document_revision": 0
      },
      "bind": "d",
      "capture": {
        "id": "/result/document/id"
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 0,
      "commands": [
        {
          "op": "add_atom",
          "element": "C",
          "position": {
            "x": 100,
            "y": 100
          }
        },
        {
          "op": "add_atom",
          "element": "F",
          "position": {
            "x": 100,
            "y": 70
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Cl",
          "position": {
            "x": 126,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "add_atom",
          "element": "Br",
          "position": {
            "x": 74,
            "y": 115
          },
          "bond_to": {
            "atom": "$0",
            "order": "single"
          }
        },
        {
          "op": "set_bond_mark",
          "bond": "$2",
          "mark": {
            "kind": "wedge",
            "narrow": "begin"
          }
        },
        {
          "op": "set_atom_configuration",
          "atom": "a1",
          "configuration": {
            "kind": "tetrahedral",
            "neighbors": [
              "a2",
              "a3",
              "a4",
              "implicit_hydrogen"
            ],
            "turn": "clockwise"
          }
        }
      ],
      "expect": {
        "document": {
          "revision": 1
        }
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "refused",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "mol",
          "records": [
            {
              "document_id": null
            }
          ]
        }
      },
      "substitute": {
        "/parameters/records/0/document_id": "id"
      },
      "expect": {
        "outcome": "error",
        "result": null,
        "diagnostics": [
          {
            "code": "unsupported_stereo",
            "details": {
              "record": 1
            }
          }
        ]
      }
    },
    {
      "call": "transact",
      "document": "d",
      "expected_revision": 1,
      "commands": [
        {
          "op": "set_bond_mark",
          "bond": "b2",
          "mark": null
        },
        {
          "op": "set_atom_configuration",
          "atom": "a1",
          "configuration": null
        }
      ],
      "expect": {
        "document": {
          "revision": 2
        }
      }
    },
    {
      "call": "operation",
      "request": {
        "contract": 1,
        "request_id": "written",
        "profile": "preserve-semantics",
        "operation": "document.export",
        "parameters": {
          "format": "mol",
          "records": [
            {
              "document_id": null
            }
          ]
        }
      },
      "substitute": {
        "/parameters/records/0/document_id": "id"
      },
      "expect": {
        "outcome": "partial",
        "result": {
          "records": [
            {
              "atoms": [
                "a1",
                "a2",
                "a3",
                "a4"
              ],
              "bonds": [
                "b1",
                "b2",
                "b3"
              ]
            }
          ]
        }
      }
    }
  ]
}
