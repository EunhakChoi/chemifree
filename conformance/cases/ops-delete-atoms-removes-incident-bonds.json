{
  "id": "ops-delete-atoms-removes-incident-bonds",
  "title": "Deleting an atom removes exactly its incident bonds, and undo brings them back",
  "requirements": ["OPS-01", "OPS-02"],
  "axis": "graph",
  "kind": "accept",
  "steps": [
    { "call": "create", "doc": "d", "title": "Scope" },
    {
      "call": "transact", "doc": "d", "expected_revision": 0,
      "commands": [
        { "op": "add_atom", "element": "C", "position": { "x": 0, "y": 0 } },
        { "op": "add_atom", "element": "C", "position": { "x": 20, "y": 0 }, "bond_to": { "atom": "$0", "order": "single" } },
        { "op": "add_atom", "element": "O", "position": { "x": 40, "y": 0 }, "bond_to": { "atom": "$1", "order": "single" } },
        { "op": "add_atom", "element": "N", "position": { "x": 0, "y": 20 }, "bond_to": { "atom": "$0", "order": "single" } }
      ],
      "expect": { "document": { "revision": 1, "bonds": [{ "id": "b1" }, { "id": "b2" }, { "id": "b3" }] } }
    },
    {
      "call": "transact", "doc": "d", "expected_revision": 1,
      "commands": [{ "op": "delete_atoms", "atoms": ["a2"] }],
      "expect": {
        "document": {
          "revision": 2,
          "atoms": [{ "id": "a1" }, { "id": "a3" }, { "id": "a4" }],
          "bonds": [{ "id": "b3", "begin": "a1", "end": "a4" }]
        }
      }
    },
    {
      "call": "undo", "doc": "d", "expected_revision": 2,
      "expect": {
        "document": {
          "atoms": [{ "id": "a1" }, { "id": "a2" }, { "id": "a3" }, { "id": "a4" }],
          "bonds": { "$contains": [{ "id": "b1" }, { "id": "b2" }, { "id": "b3" }] }
        }
      }
    }
  ]
}
