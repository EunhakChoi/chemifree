  {"name": "raw: rename repeats title", "raw": "{\"op\":\"rename\",\"title\":\"a\",\"title\":\"b\"}", "serde": "reject", "schema": {"verdict": "accept", "why": "JSON Schema cannot express a repeated key: a validator keeps one value, here the valid last one, so the schema accepts. serde refuses the repeat on the typed path as a duplicate field, and the operation envelope's strict parser refuses it before serde reads the value."}},
  {"name": "raw: command repeats op", "raw": "{\"op\":\"rename\",\"op\":\"rename\",\"title\":\"a\"}", "serde": "reject", "schema": {"verdict": "accept", "why": "JSON Schema cannot express a repeated key: a validator keeps one value, here the valid last one, so the schema accepts. serde refuses the repeat on the typed path as a duplicate field, and the operation envelope's strict parser refuses it before serde reads the value."}},
  {"name": "raw: positions repeats an instance", "raw": "{\"op\":\"add_atom\",\"element\":\"C\",\"positions\":{\"s1\":{\"x\":0,\"y\":0},\"s1\":{\"x\":1,\"y\":1}}}", "serde": "reject", "schema": {"verdict": "accept", "why": "JSON Schema cannot express a repeated key: a validator keeps one value, here the valid last one, so the schema accepts. serde refuses the repeat on the typed path as a duplicate key, and the operation envelope's strict parser refuses it before serde reads the value."}},
  {"name": "raw: selection repeats atoms", "raw": "{\"op\":\"transform_selection\",\"selection\":{\"atoms\":[\"a1\"],\"atoms\":[\"a2\"]},\"pivot\":{\"x\":0,\"y\":0},\"transform\":{\"type\":\"reflect_horizontal\"}}", "serde": "reject", "schema": {"verdict": "accept", "why": "JSON Schema cannot express a repeated key: a validator keeps one value, here the valid last one, so the schema accepts. serde refuses the repeat on the typed path as a duplicate field, and the operation envelope's strict parser refuses it before serde reads the value."}},
  {"name": "raw: reorder index 1.0", "raw": "{\"op\":\"reorder\",\"object\":\"s2\",\"index\":1.0}", "serde": "reject", "schema": {"verdict": "accept", "why": "JSON Schema's integer type admits any number with no fractional part, so 1.0 is an integer there. serde refuses a float token for an index."}},
