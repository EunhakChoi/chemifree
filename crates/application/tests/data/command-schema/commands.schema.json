    {"additionalProperties":false,"description":"Adds stored tetrahedral centers that are in no group; members already in it are left as\nthey are. Added within v1.","properties":{"atoms":{"items":{"type":"string"},"type":"array"},"group":{"type":"string"},"op":{"const":"add_stereo_group_members","type":"string"}},"required":["op","group","atoms"],"type":"object"},
