{
  "$defs": {
    "ArrangementModeDto": {"description":"Geometry-only rigid arrangements of outermost selected scene objects.","enum":["align_left","align_horizontal_center","align_right","align_top","align_vertical_center","align_bottom","distribute_horizontal","distribute_vertical"],"type":"string"},
    "AtomConfigurationDto": {"description":"What is stated about a tetrahedral stereocenter. `neighbors` are four distinct slots in\ncanonical order: atom ids ascending, then `implicit_hydrogen`, then `lone_pair`. `turn` is\nseen looking from the first slot toward the center: `anticlockwise` is OpenSMILES `@` (the\npublic model's positive `parity`), `clockwise` is `@@` (negative).","oneOf":[{"additionalProperties":false,"properties":{"kind":{"const":"tetrahedral","type":"string"},"neighbors":{"items":{"type":"string"},"maxItems":4,"minItems":4,"type":"array"},"turn":{"$ref":"#/$defs/TurnDto"}},"required":["kind","neighbors","turn"],"type":"object"},{"additionalProperties":false,"description":"Stated unknown over this neighbor set.","properties":{"kind":{"const":"unknown","type":"string"},"neighbors":{"items":{"type":"string"},"maxItems":4,"minItems":4,"type":"array"}},"required":["kind","neighbors"],"type":"object"}]},
    "BondConfigurationDto": {"description":"What is stated about a double bond. The neighbors are in canonical form: the\nlowest-identifier explicit neighbor of the end, or `implicit_hydrogen` where the end has no\nother explicit neighbor. `opposite_sides` is the public model's `opposite_side`.","oneOf":[{"additionalProperties":false,"properties":{"begin_neighbor":{"type":"string"},"end_neighbor":{"type":"string"},"kind":{"const":"relative","type":"string"},"relation":{"$ref":"#/$defs/RelationDto"}},"required":["kind","begin_neighbor","end_neighbor","relation"],"type":"object"},{"additionalProperties":false,"description":"Stated unknown or either.","properties":{"kind":{"const":"unknown","type":"string"}},"required":["kind"],"type":"object"}]},
    "BondEndDto": {"enum":["begin","end"],"type":"string"},
    "BondOrderDto": {"description":"A bond's kind. `aromatic`, `dative`, `query`, and `unknown` were added within v1; a bond of\norder `query` carries its expression in `query`.","oneOf":[{"enum":["single","double","triple","aromatic","query","unknown"],"type":"string"},{"const":"dative","description":"From `begin` (the donor) to `end`.","type":"string"}]},
    "BondQueryDto": {"description":"What a query bond stands for. `chem.substructure` matches it.","oneOf":[{"additionalProperties":false,"properties":{"kind":{"const":"any","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"One of these distinct kinds.","properties":{"kind":{"const":"list","type":"string"},"orders":{"items":{"$ref":"#/$defs/QueryBondOrderDto"},"type":"array"}},"required":["kind","orders"],"type":"object"}]},
    "BondToDto": {"additionalProperties":false,"properties":{"atom":{"type":"string"},"order":{"$ref":"#/$defs/BondOrderDto"},"query":{"anyOf":[{"$ref":"#/$defs/BondQueryDto"},{"type":"null"}],"default":null,"description":"Required with order `query`, refused with any other."}},"required":["atom","order"],"type":"object"},
    "CaptionAlignmentDto": {"description":"Physical alignment of a complete caption, independent of paragraph direction.","enum":["left","center","right"],"type":"string"},
    "CaptionRunDto": {"additionalProperties":false,"description":"A complete run value; no byte or UTF-16 substring indices cross the wire.","properties":{"color":{"default":null,"description":"Null or omission follows the theme foreground; overrides are opaque sRGB #RRGGBB.","type":["string","null"]},"font":{"anyOf":[{"$ref":"#/$defs/LabelFontDto"},{"type":"null"}],"default":null,"description":"Null or omission follows the document label font."},"outline":{"default":false,"description":"Omission means false; null and non-booleans are malformed.","type":"boolean"},"script":{"$ref":"#/$defs/CaptionScriptDto"},"shadow":{"default":false,"description":"Omission means false; null and non-booleans are malformed.","type":"boolean"},"size_pt":{"default":null,"description":"Null or omission dynamically follows the document label size (finite 4–72 pt).","format":"double","type":["number","null"]},"style":{"$ref":"#/$defs/CaptionStyleDto","default":"normal"},"text":{"type":"string"},"underline":{"default":false,"description":"Omission means false; null and non-booleans are malformed.","type":"boolean"},"weight":{"$ref":"#/$defs/CaptionWeightDto","default":"normal"}},"required":["text","script"],"type":"object"},
    "CaptionScriptDto": {"enum":["baseline","subscript","superscript"],"type":"string"},
    "CaptionStyleDto": {"enum":["normal","italic"],"type":"string"},
    "CaptionWeightDto": {"enum":["normal","bold"],"type":"string"},
    "CarbonLabelsDto": {"description":"Which carbons are labelled: `default` leaves a bonded carbon that records nothing bare.","enum":["default","all"],"type":"string"},
    "DeleteModeDto": {"enum":["subtree","object_only"],"type":"string"},
    "DisplayUnitDto": {"description":"The unit lengths are shown in; stored lengths are always pt.","enum":["pt","mm","cm","in"],"type":"string"},
    "FragmentDisplayRunDto": {"additionalProperties":false,"description":"Fragment runs inherit document label style and vary only their baseline treatment.","properties":{"script":{"$ref":"#/$defs/CaptionScriptDto"},"text":{"type":"string"}},"required":["text","script"],"type":"object"},
    "GraphicShapeDto": {"enum":["line","rectangle","ellipse","arrow","polygon","spline"],"type":"string"},
    "HydrogensDto": {"description":"An atom's recorded hydrogen state. `inferred` (the default) carries no count; a separate\nbounded inspection can derive one without changing this value.","oneOf":[{"additionalProperties":false,"properties":{"mode":{"const":"inferred","type":"string"}},"required":["mode"],"type":"object"},{"additionalProperties":false,"properties":{"mode":{"const":"unknown","type":"string"}},"required":["mode"],"type":"object"},{"additionalProperties":false,"description":"A stated count of non-vertex hydrogens, 0-16.","properties":{"count":{"format":"uint64","minimum":0,"type":"integer"},"mode":{"const":"specified","type":"string"}},"required":["mode","count"],"type":"object"}]},
    "LabelFontDto": {"description":"The generic font family of atom labels.","enum":["sans-serif","serif","monospace"],"type":"string"},
    "LabelStyleDto": {"description":"The chemical label style; independent captions retain their own run style.","enum":["normal","italic"],"type":"string"},
    "LabelWeightDto": {"description":"The chemical label weight; independent captions retain their own run weight.","enum":["normal","bold"],"type":"string"},
    "MarkDto": {"description":"A bond mark, as snapshots show it and `set_bond_mark` states it. `begin` and `end` in a mark\nare the bond's own `begin` and `end`; the bond is never rewritten to move the narrow end.\nThe public functional model's `wedge_begin` and `hash_end` display values name the same\nfacts as `wedge` and `hash` with `narrow`.","oneOf":[{"additionalProperties":false,"description":"Solid wedge on a single bond.","properties":{"kind":{"const":"wedge","type":"string"},"narrow":{"$ref":"#/$defs/BondEndDto"}},"required":["kind","narrow"],"type":"object"},{"additionalProperties":false,"description":"Hashed wedge on a single bond.","properties":{"kind":{"const":"hash","type":"string"},"narrow":{"$ref":"#/$defs/BondEndDto"}},"required":["kind","narrow"],"type":"object"},{"additionalProperties":false,"description":"Wavy single bond: unknown or either. No narrow end.","properties":{"kind":{"const":"wavy","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"Crossed double bond: unknown or either. No narrow end.","properties":{"kind":{"const":"crossed","type":"string"}},"required":["kind"],"type":"object"}]},
    "PointDto": {"additionalProperties":false,"properties":{"x":{"format":"double","type":"number"},"y":{"format":"double","type":"number"}},"required":["x","y"],"type":"object"},
    "QueryBondOrderDto": {"enum":["single","double","triple","aromatic"],"type":"string"},
    "QueryDto": {"description":"A query atom: which elements it stands for. `chem.substructure` matches it.","oneOf":[{"additionalProperties":false,"description":"Any atom; labelled `*`.","properties":{"kind":{"const":"any","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"Any atom but hydrogen; labelled `A`.","properties":{"kind":{"const":"any_heavy","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"Any atom but carbon and hydrogen; labelled `Q`.","properties":{"kind":{"const":"heteroatom","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"Any halogen; labelled `X`.","properties":{"kind":{"const":"halogen","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"One of 1-10 distinct elements, or with `negated`, any atom but them.","properties":{"elements":{"items":{"type":"string"},"type":"array"},"kind":{"const":"list","type":"string"},"negated":{"default":false,"type":"boolean"}},"required":["kind","elements"],"type":"object"}]},
    "RadicalDto": {"enum":["none","singlet","doublet","triplet","unknown"],"type":"string"},
    "ReferenceTargetDto": {"oneOf":[{"additionalProperties":false,"properties":{"id":{"type":"string"},"kind":{"const":"object","type":"string"}},"required":["kind","id"],"type":"object"},{"additionalProperties":false,"properties":{"id":{"type":"string"},"kind":{"const":"atom","type":"string"}},"required":["kind","id"],"type":"object"},{"additionalProperties":false,"properties":{"id":{"type":"string"},"kind":{"const":"bond","type":"string"}},"required":["kind","id"],"type":"object"}]},
    "RelationDto": {"enum":["same_side","opposite_sides"],"type":"string"},
    "RingDirectionDto": {"additionalProperties":false,"description":"A finite, nonzero attachment direction. Only its direction counts; its magnitude is ignored.","properties":{"dx":{"format":"double","type":"number"},"dy":{"format":"double","type":"number"}},"required":["dx","dy"],"type":"object"},
    "SelectionDto": {"additionalProperties":false,"description":"A transaction's selection snapshots. Object IDs in `after` may also use `$N` to name an\nobject created by command N in the same transaction.","properties":{"atoms":{"default":[],"items":{"type":"string"},"type":"array"},"bonds":{"default":[],"items":{"type":"string"},"type":"array"},"objects":{"default":[],"items":{"type":"string"},"type":"array"}},"type":"object"},
    "SelectionTransformDto": {"description":"Geometry-only transform about an explicit page-coordinate pivot.","oneOf":[{"additionalProperties":false,"properties":{"degrees":{"format":"double","type":"number"},"type":{"const":"rotate","type":"string"}},"required":["type","degrees"],"type":"object"},{"additionalProperties":false,"properties":{"type":{"const":"reflect_horizontal","type":"string"}},"required":["type"],"type":"object"},{"additionalProperties":false,"properties":{"type":{"const":"reflect_vertical","type":"string"}},"required":["type"],"type":"object"}]},
    "StereoGroupKindDto": {"description":"What an enhanced-stereo group states. `absolute` has no number.","enum":["absolute","and","or"],"type":"string"},
    "TurnDto": {"enum":["anticlockwise","clockwise"],"type":"string"}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One command in a transaction, tagged by `op`. Identifiers use the `a1`/`b1`/`s1` form.\nWhere a new bond names an atom (`bond_to.atom`, `begin`, `end`), `\"$N\"` also refers to\nthe atom added by the `add_atom` command at index `N` earlier in the same transaction.",
  "oneOf": [
    {"additionalProperties":false,"description":"Independent regular carbon ring, optionally a six-carbon Kekulé recipe.","properties":{"center":{"$ref":"#/$defs/PointDto"},"instance":{"type":"string"},"op":{"const":"insert_ring","type":"string"},"pattern":{"enum":["single","kekule"],"type":"string"},"size":{"enum":[5,6],"type":"integer"}},"required":["op","instance","center"],"type":"object"},
    {"additionalProperties":false,"description":"A fresh regular carbon ring connected to an existing atom by one single bond.","properties":{"atom":{"type":"string"},"direction":{"$ref":"#/$defs/RingDirectionDto"},"instance":{"type":"string"},"op":{"const":"attach_ring","type":"string"},"pattern":{"enum":["single","kekule"],"type":"string"},"size":{"enum":[5,6],"type":"integer"}},"required":["op","instance","atom","direction"],"type":"object"},
    {"additionalProperties":false,"description":"Exactly one of `position` (while the document has one scene instance) and `positions`\n(a point for each scene instance, keyed by instance identifier).\n\nThe atom is exactly one of `element` and `query`. `hydrogens` (default inferred),\n`radical` (default none), and `attachment_points` (default none) were added within v1.","properties":{"attachment_points":{"default":null,"items":{"format":"uint64","minimum":0,"type":"integer"},"type":["array","null"]},"bond_to":{"anyOf":[{"$ref":"#/$defs/BondToDto"},{"type":"null"}]},"element":{"default":null,"type":["string","null"]},"hydrogens":{"anyOf":[{"$ref":"#/$defs/HydrogensDto"},{"type":"null"}],"default":null},"op":{"const":"add_atom","type":"string"},"position":{"anyOf":[{"$ref":"#/$defs/PointDto"},{"type":"null"}]},"positions":{"additionalProperties":{"$ref":"#/$defs/PointDto"},"type":"object"},"query":{"anyOf":[{"$ref":"#/$defs/QueryDto"},{"type":"null"}],"default":null},"radical":{"anyOf":[{"$ref":"#/$defs/RadicalDto"},{"type":"null"}],"default":null}},"required":["op"],"type":"object"},
    {"additionalProperties":false,"description":"`query` is required with order `query` and refused with any other.","properties":{"begin":{"type":"string"},"end":{"type":"string"},"op":{"const":"add_bond","type":"string"},"order":{"$ref":"#/$defs/BondOrderDto"},"query":{"anyOf":[{"$ref":"#/$defs/BondQueryDto"},{"type":"null"}],"default":null}},"required":["op","begin","end","order"],"type":"object"},
    {"additionalProperties":false,"description":"Omitted fields are unchanged; `\"isotope\": null` restores natural abundance. At most one\nof `element` and `query`. The atom that results must be valid as a whole, so making a\ncharged atom a query also sends `\"charge\": 0`.","properties":{"atom":{"type":"string"},"attachment_points":{"default":null,"items":{"format":"uint64","minimum":0,"type":"integer"},"type":["array","null"]},"charge":{"default":null,"format":"int64","type":["integer","null"]},"element":{"default":null,"type":["string","null"]},"hydrogens":{"anyOf":[{"$ref":"#/$defs/HydrogensDto"},{"type":"null"}],"default":null},"isotope":{"default":null,"format":"uint64","minimum":0,"type":["integer","null"]},"op":{"const":"update_atom","type":"string"},"query":{"anyOf":[{"$ref":"#/$defs/QueryDto"},{"type":"null"}],"default":null},"radical":{"anyOf":[{"$ref":"#/$defs/RadicalDto"},{"type":"null"}],"default":null}},"required":["op","atom"],"type":"object"},
    {"additionalProperties":false,"description":"`instance` may be left out while the document has one scene instance.","properties":{"atoms":{"items":{"type":"string"},"type":"array"},"delta":{"$ref":"#/$defs/PointDto"},"instance":{"default":null,"type":["string","null"]},"op":{"const":"move_atoms","type":"string"}},"required":["op","atoms","delta"],"type":"object"},
    {"additionalProperties":false,"description":"Moves the union of existing selected objects, atoms and bond endpoints once.\nThe movement targets are independent of transaction selection_before/after.","properties":{"delta":{"$ref":"#/$defs/PointDto"},"instance":{"default":null,"type":["string","null"]},"op":{"const":"move_selection","type":"string"},"selection":{"$ref":"#/$defs/SelectionDto"}},"required":["op","selection","delta"],"type":"object"},
    {"additionalProperties":false,"description":"Arranges existing outermost scene objects as rigid units; no partial atom/bond targets.","properties":{"mode":{"$ref":"#/$defs/ArrangementModeDto"},"objects":{"items":{"type":"string"},"type":"array"},"op":{"const":"arrange_objects","type":"string"}},"required":["op","objects","mode"],"type":"object"},
    {"additionalProperties":false,"description":"Transforms resolved geometry only; stored stereo and history selection are independent.","properties":{"instance":{"default":null,"type":["string","null"]},"op":{"const":"transform_selection","type":"string"},"pivot":{"$ref":"#/$defs/PointDto"},"selection":{"$ref":"#/$defs/SelectionDto"},"transform":{"$ref":"#/$defs/SelectionTransformDto"}},"required":["op","selection","pivot","transform"],"type":"object"},
    {"additionalProperties":false,"description":"`query` is required with order `query` and refused with any other.","properties":{"bond":{"type":"string"},"op":{"const":"update_bond","type":"string"},"order":{"$ref":"#/$defs/BondOrderDto"},"query":{"anyOf":[{"$ref":"#/$defs/BondQueryDto"},{"type":"null"}],"default":null}},"required":["op","bond","order"],"type":"object"},
    {"additionalProperties":false,"properties":{"atoms":{"items":{"type":"string"},"type":"array"},"op":{"const":"delete_atoms","type":"string"}},"required":["op","atoms"],"type":"object"},
    {"additionalProperties":false,"properties":{"bonds":{"items":{"type":"string"},"type":"array"},"op":{"const":"delete_bonds","type":"string"}},"required":["op","bonds"],"type":"object"},
    {"additionalProperties":false,"properties":{"op":{"const":"rename","type":"string"},"title":{"type":"string"}},"required":["op","title"],"type":"object"},
    {"additionalProperties":false,"description":"Copies the positions of `source` (default: the first instance) moved by `offset`.","properties":{"offset":{"$ref":"#/$defs/PointDto"},"op":{"const":"add_instance","type":"string"},"source":{"default":null,"type":["string","null"]}},"required":["op","offset"],"type":"object"},
    {"additionalProperties":false,"properties":{"instance":{"type":"string"},"offset":{"$ref":"#/$defs/PointDto"},"op":{"const":"move_instance","type":"string"}},"required":["op","instance","offset"],"type":"object"},
    {"additionalProperties":false,"properties":{"instance":{"type":"string"},"op":{"const":"delete_instance","type":"string"}},"required":["op","instance"],"type":"object"},
    {"additionalProperties":false,"description":"Explicit members retain their chemistry; text is presentation only.","properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"members":{"items":{"type":"string"},"type":"array"},"op":{"const":"contract_fragment","type":"string"},"text":{"type":"string"}},"required":["op","instance","anchor","members","text"],"type":"object"},
    {"additionalProperties":false,"properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"op":{"const":"set_fragment_display_text","type":"string"},"text":{"type":"string"}},"required":["op","instance","anchor","text"],"type":"object"},
    {"additionalProperties":false,"properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"op":{"const":"set_fragment_display_runs","type":"string"},"runs":{"items":{"$ref":"#/$defs/FragmentDisplayRunDto"},"type":"array"}},"required":["op","instance","anchor","runs"],"type":"object"},
    {"additionalProperties":false,"properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"op":{"const":"expand_fragment","type":"string"}},"required":["op","instance","anchor"],"type":"object"},
    {"additionalProperties":false,"properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"op":{"const":"collapse_ethyl","type":"string"},"terminal":{"type":"string"}},"required":["op","instance","anchor","terminal"],"type":"object"},
    {"additionalProperties":false,"properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"op":{"const":"update_abbreviation_label","type":"string"},"text":{"type":["string","null"]}},"required":["op","instance","anchor","text"],"type":"object"},
    {"additionalProperties":false,"properties":{"anchor":{"type":"string"},"instance":{"type":"string"},"op":{"const":"expand_ethyl","type":"string"}},"required":["op","instance","anchor"],"type":"object"},
    {"additionalProperties":false,"properties":{"alignment":{"$ref":"#/$defs/CaptionAlignmentDto","default":"left"},"anchor":{"$ref":"#/$defs/PointDto"},"index":{"default":null,"format":"uint","minimum":0,"type":["integer","null"]},"op":{"const":"add_caption","type":"string"},"parent":{"default":null,"type":["string","null"]},"runs":{"items":{"$ref":"#/$defs/CaptionRunDto"},"type":"array"}},"required":["op","anchor","runs"],"type":"object"},
    {"additionalProperties":false,"properties":{"alignment":{"$ref":"#/$defs/CaptionAlignmentDto","default":"left"},"anchor":{"$ref":"#/$defs/PointDto"},"object":{"type":"string"},"op":{"const":"update_caption","type":"string"},"runs":{"items":{"$ref":"#/$defs/CaptionRunDto"},"type":"array"}},"required":["op","object","anchor","runs"],"type":"object"},
    {"additionalProperties":false,"properties":{"data_base64":{"type":"string"},"index":{"format":"uint","minimum":0,"type":["integer","null"]},"mime_type":{"type":"string"},"op":{"const":"add_image","type":"string"},"origin":{"$ref":"#/$defs/PointDto"},"parent":{"type":["string","null"]},"size_pt":{"$ref":"#/$defs/PointDto"}},"required":["op","mime_type","data_base64","origin","size_pt"],"type":"object"},
    {"additionalProperties":false,"properties":{"object":{"type":"string"},"op":{"const":"update_image_geometry","type":"string"},"origin":{"$ref":"#/$defs/PointDto"},"size_pt":{"$ref":"#/$defs/PointDto"}},"required":["op","object","origin","size_pt"],"type":"object"},
    {"additionalProperties":false,"properties":{"index":{"default":null,"format":"uint","minimum":0,"type":["integer","null"]},"op":{"const":"add_graphic","type":"string"},"parent":{"default":null,"type":["string","null"]},"points":{"items":{"$ref":"#/$defs/PointDto"},"maxItems":2,"minItems":2,"type":"array"},"shape":{"$ref":"#/$defs/GraphicShapeDto"}},"required":["op","shape","points"],"type":"object"},
    {"additionalProperties":false,"properties":{"index":{"format":"uint","minimum":0,"type":["integer","null"]},"op":{"const":"add_spline","type":"string"},"parent":{"type":["string","null"]},"points":{"items":{"$ref":"#/$defs/PointDto"},"maxItems":4,"minItems":4,"type":"array"}},"required":["op","points"],"type":"object"},
    {"additionalProperties":false,"properties":{"object":{"type":"string"},"op":{"const":"update_spline_points","type":"string"},"points":{"items":{"$ref":"#/$defs/PointDto"},"maxItems":4,"minItems":4,"type":"array"}},"required":["op","object","points"],"type":"object"},
    {"additionalProperties":false,"properties":{"index":{"format":"uint","minimum":0,"type":["integer","null"]},"op":{"const":"add_polygon","type":"string"},"parent":{"type":["string","null"]},"vertices":{"items":{"$ref":"#/$defs/PointDto"},"type":"array"}},"required":["op","vertices"],"type":"object"},
    {"additionalProperties":false,"properties":{"object":{"type":"string"},"op":{"const":"update_polygon_vertices","type":"string"},"vertices":{"items":{"$ref":"#/$defs/PointDto"},"type":"array"}},"required":["op","object","vertices"],"type":"object"},
    {"additionalProperties":false,"properties":{"object":{"type":"string"},"op":{"const":"update_graphic_points","type":"string"},"points":{"items":{"$ref":"#/$defs/PointDto"},"maxItems":2,"minItems":2,"type":"array"}},"required":["op","object","points"],"type":"object"},
    {"additionalProperties":false,"properties":{"line_width_pt":{"format":"double","type":["number","null"]},"object":{"type":"string"},"op":{"const":"set_graphic_line_width","type":"string"}},"required":["op","object","line_width_pt"],"type":"object"},
    {"additionalProperties":false,"properties":{"objects":{"items":{"type":"string"},"type":"array"},"op":{"const":"group","type":"string"}},"required":["op","objects"],"type":"object"},
    {"additionalProperties":false,"properties":{"group":{"type":"string"},"op":{"const":"ungroup","type":"string"}},"required":["op","group"],"type":"object"},
    {"additionalProperties":false,"properties":{"index":{"format":"uint","minimum":0,"type":"integer"},"object":{"type":"string"},"op":{"const":"reorder","type":"string"}},"required":["op","object","index"],"type":"object"},
    {"additionalProperties":false,"properties":{"mode":{"anyOf":[{"$ref":"#/$defs/DeleteModeDto"},{"type":"null"}]},"objects":{"items":{"type":"string"},"type":"array"},"op":{"const":"delete_objects","type":"string"}},"required":["op","objects"],"type":"object"},
    {"additionalProperties":false,"properties":{"delta":{"$ref":"#/$defs/PointDto"},"objects":{"items":{"type":"string"},"type":"array"},"op":{"const":"move_objects","type":"string"}},"required":["op","objects","delta"],"type":"object"},
    {"additionalProperties":false,"properties":{"op":{"const":"add_reference","type":"string"},"source":{"type":"string"},"target":{"$ref":"#/$defs/ReferenceTargetDto"}},"required":["op","source","target"],"type":"object"},
    {"additionalProperties":false,"properties":{"op":{"const":"remove_reference","type":"string"},"source":{"type":"string"},"target":{"$ref":"#/$defs/ReferenceTargetDto"}},"required":["op","source","target"],"type":"object"},
    {"additionalProperties":false,"properties":{"bond_length_pt":{"default":null,"format":"double","type":["number","null"]},"carbon_labels":{"anyOf":[{"$ref":"#/$defs/CarbonLabelsDto"},{"type":"null"}],"default":null},"display_unit":{"anyOf":[{"$ref":"#/$defs/DisplayUnitDto"},{"type":"null"}],"default":null},"label_font":{"anyOf":[{"$ref":"#/$defs/LabelFontDto"},{"type":"null"}],"default":null},"label_outline":{"default":null,"type":["boolean","null"]},"label_shadow":{"default":null,"type":["boolean","null"]},"label_size_pt":{"default":null,"format":"double","type":["number","null"]},"label_style":{"anyOf":[{"$ref":"#/$defs/LabelStyleDto"},{"type":"null"}],"default":null},"label_underline":{"default":null,"type":["boolean","null"]},"label_weight":{"anyOf":[{"$ref":"#/$defs/LabelWeightDto"},{"type":"null"}],"default":null},"line_width_pt":{"default":null,"format":"double","type":["number","null"]},"op":{"const":"update_settings","type":"string"}},"required":["op"],"type":"object"},
    {"additionalProperties":false,"description":"Sets how a bond is drawn, or with `\"mark\": null` clears it. `mark` is required. `bond`\nis a bond ID, or `\"$N\"` for the bond created by command N: an `add_bond`'s bond, or the\n`bond_to` bond of an `add_atom`. Added within v1.","properties":{"bond":{"type":"string"},"mark":{"anyOf":[{"$ref":"#/$defs/MarkDto"},{"type":"null"}]},"op":{"const":"set_bond_mark","type":"string"}},"required":["op","bond","mark"],"type":"object"},
    {"additionalProperties":false,"description":"States a stereocenter's neighbor order and turn (or states it unknown), or with\n`\"configuration\": null` clears the statement. `configuration` is required. Neighbors\nare atom IDs, `\"$N\"` for an atom created by command N, `\"implicit_hydrogen\"` or\n`\"lone_pair\"`, in any order. Added within v1.","properties":{"atom":{"type":"string"},"configuration":{"anyOf":[{"$ref":"#/$defs/AtomConfigurationDto"},{"type":"null"}]},"op":{"const":"set_atom_configuration","type":"string"}},"required":["op","atom","configuration"],"type":"object"},
    {"additionalProperties":false,"description":"States how one neighbor of each end of a double bond lies across it (or states it\nunknown), or with `\"configuration\": null` clears the statement. `configuration` is\nrequired; `bond` is as in `set_bond_mark`. Added within v1.","properties":{"bond":{"type":"string"},"configuration":{"anyOf":[{"$ref":"#/$defs/BondConfigurationDto"},{"type":"null"}]},"op":{"const":"set_bond_configuration","type":"string"}},"required":["op","bond","configuration"],"type":"object"},
    {"additionalProperties":false,"description":"Stores the configuration the bond marks and one scene instance's positions show. With\nneither list, for each center a wedge, hash or wavy mark bears on and each crossed\ndouble bond; with `atoms` and/or `bonds` (IDs or `\"$N\"`, each non-empty), exactly those,\nall of which must derive. `instance` may be left out while the document has one scene\ninstance. Added within v1.","properties":{"atoms":{"default":null,"items":{"type":"string"},"type":["array","null"]},"bonds":{"default":null,"items":{"type":"string"},"type":["array","null"]},"instance":{"default":null,"type":["string","null"]},"op":{"const":"set_configuration_from_drawing","type":"string"}},"required":["op"],"type":"object"},
    {"additionalProperties":false,"description":"Creates an enhanced-stereo group of stored tetrahedral centers that are in no group\n(`atoms`: atom IDs or `\"$N\"`, non-empty). `number` is required, an integer within the\n32-bit signed range or `null`; an `absolute` group takes none. The new group is `\"$N\"`\nfor later commands. Added within v1.","properties":{"atoms":{"items":{"type":"string"},"type":"array"},"kind":{"$ref":"#/$defs/StereoGroupKindDto"},"number":{"format":"int64","type":["integer","null"]},"op":{"const":"create_stereo_group","type":"string"}},"required":["op","kind","atoms","number"],"type":"object"},
